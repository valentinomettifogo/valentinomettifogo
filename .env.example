# Public: inlined at build time via $env/static/public.
# On Vercel set these in Production, Preview and Development.
PUBLIC_SUPABASE_URL=https://your-ref.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Secrets: read at runtime via $env/dynamic/private, rotatable without a rebuild.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# Shared secret Qlik Cloud sends back on every webhook call (checked in
# isAuthorized() in api/webhooks/qlik/+server.ts). Unrelated to a tenant's own
# api_key, which is used for outgoing calls to Qlik's REST API. Generate with:
#   node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
QLIK_WEBHOOK_TOKEN=

# Incoming webhook URL of the Google Chat space every Qlik alert is posted to
# (Space -> Apps & integrations -> Webhooks). One space for all tenants.
# Without it the endpoint answers 500 no_notifier instead of dropping the alert.
GOOGLE_CHAT_WEBHOOK_URL=

# Set to 1 to log the full JSON of every accepted Qlik event. Useful to inspect
# the real payload shape a tenant sends; noisy, so turn it off afterwards.
QLIK_WEBHOOK_DEBUG=

# Who gets into /portal is not an env var: it is the `role` column of the
# public.users table ('analytics' or 'admin'), set from the Supabase table editor.
